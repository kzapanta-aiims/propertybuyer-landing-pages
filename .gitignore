package-lock.json
.DS_Store

# Paper artwork downloaded by tools/import-paper-images.mjs. Scratch, and
# large: the originals are several MB each and the committed WebP crops are
# derived from them. The tool re-fetches anything missing, so nothing here
# needs keeping.
.paper-src/

# Client success-story decks, read by tools/extract-deck-images.mjs. They are
# client working files rather than source, several MB each, and the committed
# WebP photographs are derived from them.
.deck-src/

# The repository root is the client folder, so these two sit inside it without
# being part of the build. They are client working files, not source, and the
# remote is not where they belong.
Brand Assets/
CRO/

# Pulled client feedback rounds, written by the client-review skill
# (/client-review pull). Working material for acting on a round; the threads
# themselves live in the feedback hub, so nothing here needs keeping.
.feedback/
